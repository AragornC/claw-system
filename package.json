{
  "name": "thunderclaw",
  "version": "0.0.1",
  "description": "ThunderClaw OpenClaw onboarding shell",
  "bin": {
    "thunderclaw": "scripts/thunderclaw-cli.js"
  },
  "scripts": {
    "thunderclaw:help": "node scripts/thunderclaw-cli.js help",
    "thunderclaw:start": "npm run thunderclaw:setup:freqtrade && node scripts/thunderclaw-cli.js start",
    "thunderclaw:setup:freqtrade": "bash scripts/setup-install-freqtrade.sh",
    "thunderclaw:status": "node scripts/thunderclaw-cli.js status",
    "thunderclaw:assets": "node scripts/thunderclaw-cli.js assets",
    "thunderclaw:idea": "node scripts/thunderclaw-cli.js idea",
    "e2e:clarification-flow": "node scripts/e2e/e2e-clarification-flow-test.js",
    "e2e:browser-workbench": "node scripts/e2e/e2e-browser-clarification-workbench-test.js"
  },
  "keywords": [
    "thunderclaw",
    "openclaw",
    "onboarding"
  ],
  "author": "ThunderClaw",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "openclaw": "^2026.2.21-2"
  },
  "devDependencies": {
    "playwright": "^1.58.2"
  }
}
