# ThunderClaw 即插即用推荐配置
# 模型连接走引导命令：npm run openclaw:setup:local
OPENCLAW_AGENT_LOCAL=1
OPENCLAW_AGENT_ID=main

# OpenClaw 默认推理参数
OPENCLAW_THINKING=medium
OPENCLAW_VERBOSE=off
OPENCLAW_TIMEOUT_SEC=90
OPENCLAW_CHAT_TIMEOUT_MS=95000
OPENCLAW_SESSION_LOCK_RETRY=4
OPENCLAW_SESSION_LOCK_BACKOFF_MS=650

# OpenClaw-native 聊天内核 + MCP bridge 能力路由
THUNDERCLAW_CHAT_RUNTIME_MODE=openclaw-native
THUNDERCLAW_TOOL_ADAPTER=mcp
THUNDERCLAW_MCP_BRIDGE_ENABLED=1
THUNDERCLAW_MCP_BRIDGE_AUTOSTART=1
THUNDERCLAW_FORCE_CAPABILITY_PROFILE=1
THUNDERCLAW_MCP_BRIDGE_PORT=9001
THUNDERCLAW_MCP_BRIDGE_URL=http://127.0.0.1:9001/tool/invoke
THUNDERCLAW_MCP_BRIDGE_TIMEOUT_MS=6500
THUNDERCLAW_MCP_BRIDGE_RETRY=1
THUNDERCLAW_MCP_BRIDGE_FALLBACK=internal

# Telegram：只需要填 bot token 即可
# 也可以启动后在聊天框里发送“设置 Telegram token ...”来更新
THUNDERCLAW_TELEGRAM_BOT_TOKEN=

# 默认行为：来信自动回复 + 交易事件主动推送
THUNDERCLAW_TELEGRAM_AUTO_REPLY=1
THUNDERCLAW_TELEGRAM_PUSH_TRADES=1
THUNDERCLAW_TELEGRAM_PUSH_EVENTS=open,close,risk
THUNDERCLAW_TELEGRAM_PUSH_INTERVAL_MS=4000

PORT=8765

# ---- 高级可选（大多数用户不用） ----
# THUNDERCLAW_TELEGRAM_ALLOWED_CHAT_IDS=123456789
# THUNDERCLAW_TELEGRAM_PUSH_CHAT_IDS=123456789
# THUNDERCLAW_TELEGRAM_POLL_LOCK_STALE_MS=180000
# THUNDERCLAW_SERVICE_LOCK_STALE_MS=480000
# THUNDERCLAW_TELEGRAM_INBOUND_DEDUPE_TTL_MS=604800000
# THUNDERCLAW_MEMORY_RETRIEVE_TOPK=8
# THUNDERCLAW_MEMORY_MAX_ITEMS=4000
# THUNDERCLAW_MEMORY_SHORT_MAX_ITEMS=120
# THUNDERCLAW_MEMORY_SHORT_RETRIEVE_TOPK=6
# THUNDERCLAW_MEMORY_MID_TOP_STRATEGIES=6
# THUNDERCLAW_STRATEGY_FEEDBACK_LR=0.16
# THUNDERCLAW_STRATEGY_FEEDBACK_TRADE_PNL_SCALE=0.01
# THUNDERCLAW_STRATEGY_FEEDBACK_SCAN_LIMIT=1200
# THUNDERCLAW_STRATEGY_ARTIFACTS_MAX_ITEMS=1200
# THUNDERCLAW_STRATEGY_ARTIFACTS_TOPK=8
# THUNDERCLAW_STRATEGY_ARTIFACT_LR=0.18
